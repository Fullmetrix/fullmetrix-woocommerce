msgstr "Verbindingscode niet gevonden. Controleer je code in Fullmetrix."

#: includes/class-fullmetrix-api.php:736
msgid "This code is already associated with another site."
msgstr "Deze code is al gekoppeld aan een andere site."

#: includes/class-fullmetrix-api.php:740
msgid "Unknown error"
msgstr "Onbekende fout"

#. translators: %s: error message
